{
  "name": "drosophila-local-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-dependencies.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "local": "node scripts/local-workspace.mjs",
    "local:stop": "node scripts/local-workspace.mjs stop",
    "local:backup": "node scripts/local-backup.mjs",
    "local:restore": "node scripts/local-restore.mjs",
    "test:local": "node --test tests/local/*.test.mjs",
    "lint": "eslint . --suppressions-location .eslint-suppressions.json --max-warnings 19",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/local/*.test.mjs",
    "test:research": "node scripts/research/check-all.mjs",
    "test:python": "uv run --frozen python -m unittest research.lab.test_lab research.lab.test_discovery && uv run --frozen python -m unittest discover -s research -p test_runner.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run test:research",
    "lint:debt": "eslint . --suppressions-location .validation/no-suppressions.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "8.16.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "6.2.2",
    "supabase": "2.39.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "@types/three": "^0.185.4",
    "prettier": "3.6.2"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
