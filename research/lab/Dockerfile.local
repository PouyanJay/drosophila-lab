FROM ghcr.io/astral-sh/uv:0.11.17 AS uv
FROM python:3.11-slim
COPY --from=uv /uv /uvx /bin/
WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock .python-version /app/
RUN uv sync --frozen --no-dev --no-install-project
COPY research/lab /app/research/lab
COPY public/research/persistent-trainer.zip /tmp/trainer.zip
RUN uv run --no-sync python -c "import zipfile; z=zipfile.ZipFile('/tmp/trainer.zip'); [z.extract(n,'/app') for n in z.namelist() if n.startswith('graph/')]" && rm /tmp/trainer.zip
ENV LAB_GRAPH_DIR=/app/graph LAB_DATA_DIR=/data/runs LAB_THREADS=2 PYTHONUNBUFFERED=1
CMD ["/app/.venv/bin/uvicorn","research.lab.service:create_app","--factory","--host","0.0.0.0","--port","8000","--workers","1","--no-access-log"]
